# magicJar SLM Lab local environment
# Copy to .env for local PoC runs.

SPRING_PROFILES_ACTIVE=dev,real-kis
TZ=Asia/Seoul

# Hard safety defaults
MAGICJAR_MODE=MOCK
MAGICJAR_ALLOW_REAL=false
MAGICJAR_AI_ENABLED=true
MAGICJAR_AI_MOCK_MODE=auto

# Local isolated host ports
API_HOST_PORT=18080
BATCH_HOST_PORT=18081
CONSUMER_HOST_PORT=18082
FRONTEND_HOST_PORT=13000
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
KAFKA_HOST_PORT=19092
KAFKA_UI_HOST_PORT=18090
DOZZLE_HOST_PORT=18888

# Database defaults for lab containers
DB_URL=jdbc:postgresql://localhost:15432/magicjar_slm
DB_USER=magicjar
DB_PASSWORD=magicjar
REDIS_HOST=localhost
REDIS_PORT=16379
KAFKA_BOOTSTRAP=localhost:19092

# Secret for local encryption only. Replace locally; do not commit .env.
MAGICJAR_SECRET_MASTER_KEY=

# Strategy research SLM provider draft config
MAGICJAR_STRATEGY_RESEARCH_AI_DISCOVERY_ENABLED=true
MAGICJAR_STRATEGY_RESEARCH_AI_DISCOVERY_PROVIDER=ollama
MAGICJAR_STRATEGY_RESEARCH_AI_DISCOVERY_TIMEOUT_SECONDS=60

# Ollama-compatible local model endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_PREDICT=1024

# Keep real credentials empty in the lab.
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_ACCOUNT_CANO=
KIS_ACCOUNT_PRDT=01
KIS_HTS_ID=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
