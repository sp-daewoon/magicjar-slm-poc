### magicJar — KIS OpenAPI HTTP Client (IntelliJ / VS Code REST Client)
#
# 사용법:
#   1. http-client.private.env.json 에 appkey/appsecret 한 번만 입력 (이 파일은 .gitignore — 커밋 안 됨)
#   2. 우측 상단 env 선택: real(실전) 또는 vps(모의)
#   3. "1. 토큰 발급" 의 ▶ 실행 → accessToken 이 자동 저장됨(아래 요청들이 그대로 사용)
#   4. 검증할 요청의 ▶ 클릭
#
# 시크릿은 절대 이 .http 파일에 적지 말 것 — {{appkey}}/{{appsecret}} 변수로만 참조.

# ============================================================
# 1. 토큰 발급 — 실행하면 accessToken 자동 캡처 (24h 유효, 1분당 1회 제한)
# ============================================================
### 토큰 발급
# @name token
POST {{kisDomain}}/oauth2/tokenP
Content-Type: application/json

{
  "grant_type": "client_credentials",
  "appkey": "{{appkey}}",
  "appsecret": "{{appsecret}}"
}

> {%
    client.global.set("accessToken", response.body.access_token);
    client.log("token len = " + (response.body.access_token || "").length);
%}

# ============================================================
# 2. 기간별 일봉 FHKST03010100 — 일봉 갭 검증 (036930 2/11 이후)
#    J=KRX / NX=NXT / UN=통합. mrkt_div 만 바꿔 J vs NX 비교.
# ============================================================
### 036930 일봉 — J(KRX) 채널 (2026-02-12 ~ 06-09)
GET {{kisDomain}}/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD=036930&FID_INPUT_DATE_1=20260212&FID_INPUT_DATE_2=20260609&FID_PERIOD_DIV_CODE=D&FID_ORG_ADJ_PRC=0
authorization: Bearer {{accessToken}}
appkey: {{appkey}}
appsecret: {{appsecret}}
tr_id: FHKST03010100
custtype: P

> {%
    const o = response.body.output2 || [];
    const rows = o.filter(r => r.stck_bsop_date);
    client.log("rt_cd=" + response.body.rt_cd + " msg=" + response.body.msg1);
    client.log("rows=" + rows.length +
        " newest=" + (rows[0] && rows[0].stck_bsop_date) +
        " oldest=" + (rows[rows.length-1] && rows[rows.length-1].stck_bsop_date));
    // 판정: rows>0 & newest≈20260609 → KIS J엔 있음(=우리 채널 결함) / rows=0 or newest=20260211 → KIS 부재
%}

### 036930 일봉 — NX(NXT) 채널 (J와 비교)
GET {{kisDomain}}/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice?FID_COND_MRKT_DIV_CODE=NX&FID_INPUT_ISCD=036930&FID_INPUT_DATE_1=20260212&FID_INPUT_DATE_2=20260609&FID_PERIOD_DIV_CODE=D&FID_ORG_ADJ_PRC=0
authorization: Bearer {{accessToken}}
appkey: {{appkey}}
appsecret: {{appsecret}}
tr_id: FHKST03010100
custtype: P

> {%
    const o = response.body.output2 || [];
    client.log("NX rows=" + o.length + " newest=" + (o[0] && o[0].stck_bsop_date));
%}

### 047040 일봉 — J 채널 (다른 stale 종목 교차검증)
GET {{kisDomain}}/uapi/domestic-stock/v1/quotations/inquire-daily-itemchartprice?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD=047040&FID_INPUT_DATE_1=20260212&FID_INPUT_DATE_2=20260609&FID_PERIOD_DIV_CODE=D&FID_ORG_ADJ_PRC=0
authorization: Bearer {{accessToken}}
appkey: {{appkey}}
appsecret: {{appsecret}}
tr_id: FHKST03010100
custtype: P

# ============================================================
# 3. 현재가 시세 FHKST01010100 — 당일 OHLCV 스냅샷
# ============================================================
### 036930 현재가
GET {{kisDomain}}/uapi/domestic-stock/v1/quotations/inquire-price?FID_COND_MRKT_DIV_CODE=J&FID_INPUT_ISCD=036930
authorization: Bearer {{accessToken}}
appkey: {{appkey}}
appsecret: {{appsecret}}
tr_id: FHKST01010100
custtype: P

# ============================================================
# 4. 관심종목(멀티종목) 시세 FHKST11300006 — NXT 통합 검증 (ADR 0118 R1)
#    장 마감 후(밤) 실행해야 확정값. J vs NX 종가/거래량 비교.
# ============================================================
### 005930 멀티시세 — J vs NX
GET {{kisDomain}}/uapi/domestic-stock/v1/quotations/intstock-multprice?FID_COND_MRKT_DIV_CODE_1=J&FID_INPUT_ISCD_1=005930&FID_COND_MRKT_DIV_CODE_2=NX&FID_INPUT_ISCD_2=005930
authorization: Bearer {{accessToken}}
appkey: {{appkey}}
appsecret: {{appsecret}}
tr_id: FHKST11300006
custtype: P

> {%
    (response.body.output || []).forEach(r =>
        client.log(r.inter_shrn_iscd + " clpr=" + r.inter2_prpr + " vol=" + r.acml_vol + " trpbmn=" + r.acml_tr_pbmn));
%}
